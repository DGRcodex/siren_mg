generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model DiagnosticoLead {
  id               String   @id @default(uuid())
  razonSocial      String
  rubro            String
  facturacionAnual Float
  moneda           String
  nivelMadurez     Float
  fugaTotal        Float
  respuestasJson   String   // Guardamos las respuestas originales como texto JSON
  idioma           String   @default("es")
  createdAt        DateTime @default(now())
}
